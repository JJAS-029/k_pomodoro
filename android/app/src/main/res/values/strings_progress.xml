    <string name="prog_guide_welcome_title">Hi! Welcome to your lab</string>
    <string name="prog_guide_welcome_body1">Here, every focus session is an experiment. While you work, the liquid evaporates; when you rest, the vessel fills back up.</string>
    <string name="prog_guide_welcome_body2">Your focus time earns you elements from the periodic table, and over time you\'ll discover which hours and days you do your best work.</string>
    <string name="prog_guide_welcome_body3">Here\'s how it works in a few steps. If you already know, tap Skip.</string>

    <string name="prog_guide_lab_title">Your focus lab</string>
    <string name="prog_guide_work">Work</string>
    <string name="prog_guide_break">Break</string>
    <string name="prog_guide_lab_body">As you work, the liquid slowly evaporates. During breaks, the vessel fills back up.\n\nEach session in your plan gets its own vessel and color.</string>

