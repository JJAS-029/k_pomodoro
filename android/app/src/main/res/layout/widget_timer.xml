<?xml version="1.0" encoding="utf-8"?>
<!-- Widget del timer: recipiente a la izquierda; a la derecha, el texto y debajo los controles,
     para que el tiempo tenga todo el ancho aunque el widget sea angosto. Lo llena TimerWidgetSync -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <ImageView
        android:id="@+id/widget_vessel"
        android:layout_width="64dp"
        android:layout_height="88dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFCCCCCC"
            android:textSize="13sp" />

        <Chronometer
            android:id="@+id/widget_chrono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/widget_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FF9E9E9E"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_primary"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_button"
                android:contentDescription="@null"
                android:scaleType="center" />

            <ImageButton
                android:id="@+id/widget_skip"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_button"
                android:contentDescription="@string/widget_skip"
                android:scaleType="center"
                android:src="@drawable/ic_skip" />

            <ImageButton
                android:id="@+id/widget_stop"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_button"
                android:contentDescription="@string/widget_stop"
                android:scaleType="center"
                android:src="@drawable/ic_stop" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
