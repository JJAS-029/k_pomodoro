    <string name="prog_guide_welcome_title">¡Hola! Te damos la bienvenida a tu laboratorio</string>
    <string name="prog_guide_welcome_body1">Aquí cada sesión de enfoque es un experimento. Mientras trabajas, el líquido se evapora; al descansar, el recipiente se vuelve a llenar.</string>
    <string name="prog_guide_welcome_body2">Con tu tiempo de enfoque ganas elementos de la tabla periódica, y con el tiempo descubrirás a qué hora y qué días rindes más.</string>
    <string name="prog_guide_welcome_body3">Te explico cómo funciona en unos pasos. Si ya lo conoces, toca Saltar.</string>

    <string name="prog_guide_lab_title">Tu laboratorio de enfoque</string>
    <string name="prog_guide_work">Trabajo</string>
    <string name="prog_guide_break">Descanso</string>
    <string name="prog_guide_lab_body">Mientras trabajas, el líquido se evapora poco a poco. En el descanso, el recipiente se vuelve a llenar.\n\nCada sesión del plan usa un recipiente y un color distintos.</string>

